{
  "name": "planner-mcp",
  "version": "0.2.0",
  "description": "MCP server for a self-hosted Planner backend: task + work-router tools over stdio or streamable HTTP, with named API-key auth and a REST proxy for OpenAPI clients.",
  "type": "module",
  "bin": {
    "planner-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/server.js --http 8770",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "planner",
    "ingest",
    "task-management"
  ],
  "author": "Greg Thompson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gregory597x/planner-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gregory597x/planner-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
